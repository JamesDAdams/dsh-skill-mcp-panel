{
  "name": "dsh-skill-mcp-panel",
  "version": "2.6.5",
  "description": "dsh-skill-mcp-panel fork: manage skills and MCP servers from the DSH web sidebar, with the MCP companion built in (servers mounted by other plugins, persistent switches, per-conversation MCP chip, Tools and System prompt tabs) and the token estimator (composer cost of the next request).",
  "homepage": "https://github.com/JamesDAdams/dsh-skill-mcp-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesDAdams/dsh-skill-mcp-panel.git"
  },
  "bugs": {
    "url": "https://github.com/JamesDAdams/dsh-skill-mcp-panel/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "mcp",
    "tokens"
  ],
  "type": "module",
  "main": "lib/entry.js",
  "exports": {
    ".": "./lib/entry.js",
    "./client": "./lib/client.merged.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^5.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "bin": {
    "dsh-panel": "lib/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/strip-client-export.mjs && node scripts/merge-client.mjs",
    "prepack": "tsc -p tsconfig.json && node scripts/strip-client-export.mjs && node scripts/merge-client.mjs"
  },
  "files": [
    "lib",
    "vendor",
    "assets",
    "README.md",
    "README.en.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.1"
  }
}
